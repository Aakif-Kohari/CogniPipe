OPENAI_API_KEY=sk-...

# Anthropic (required for node-anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# Slack (required for node-slack)
SLACK_BOT_TOKEN=xoxb-...

# GitHub (required for node-github)
GITHUB_TOKEN=ghp_...
