{
  "name": "@cognipipe/sdk",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "description": "BaseNode abstract class and @CogniNode() decorator for building CogniPipe nodes",
  "main": "./dist/cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json && node scripts/postbuild-cjs.js",
    "test": "jest --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@cognipipe/core": "workspace:*",
    "@cognipipe/types": "workspace:*",
    "zod": "^4.4.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aakif-Kohari/CogniPipe.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ]
}
