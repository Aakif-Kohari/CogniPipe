{
  "name": "@cognipipe/testing",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=11.10.0"
  },
  "description": "Test utilities for CogniPipe nodes and workflows",
  "main": "./dist/cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json && node scripts/postbuild-cjs.js",
    "test": "jest --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@cognipipe/types": "workspace:*"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aakif-Kohari/CogniPipe.git",
    "directory": "packages/testing"
  },
  "homepage": "https://github.com/Aakif-Kohari/CogniPipe/tree/main/packages/testing#readme",
  "bugs": {
    "url": "https://github.com/Aakif-Kohari/CogniPipe/issues"
  },
  "author": "Aakif Kohari <kohariaakif@gmail.com>",
  "keywords": [
    "cognipipe",
    "workflow",
    "automation",
    "pipeline",
    "typescript"
  ],
  "private": true
}
