{
  "name": "@cognipipe/core",
  "version": "0.4.0",
  "type": "module",
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=11.10.0"
  },
  "description": "Core workflow execution engine for CogniPipe",
  "main": "./dist/cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json && node scripts/postbuild-cjs.js",
    "test": "jest --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@cognipipe/types": "workspace:*",
    "js-yaml": "^5.4.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "fast-check": "^4.10.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aakif-Kohari/CogniPipe.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Aakif-Kohari/CogniPipe/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/Aakif-Kohari/CogniPipe/issues"
  },
  "author": "Aakif Kohari <kohariaakif@gmail.com>",
  "keywords": [
    "cognipipe",
    "workflow",
    "automation",
    "pipeline",
    "typescript"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist"
  ]
}
