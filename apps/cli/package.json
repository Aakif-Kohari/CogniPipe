{
  "name": "cognipipe",
  "version": "0.1.5",
  "type": "module",
  "description": "Code-first workflow automation engine",
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=11.10.0"
  },
  "bin": {
    "cognipipe": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "@cognipipe/core": "workspace:*",
    "@cognipipe/types": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aakif-Kohari/CogniPipe.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/Aakif-Kohari/CogniPipe/tree/main/apps/cli#readme",
  "bugs": {
    "url": "https://github.com/Aakif-Kohari/CogniPipe/issues"
  },
  "author": "Aakif Kohari <kohariaakif@gmail.com>",
  "keywords": [
    "cognipipe",
    "workflow",
    "automation",
    "pipeline",
    "typescript"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist"
  ]
}
