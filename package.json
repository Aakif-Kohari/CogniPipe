{
  "name": "cognipipe",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
  "type": "module",
  "description": "Code-first workflow automation engine for developers",
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=11.10.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yaml,yml}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yaml,yml}\" --ignore-path .gitignore",
    "type-check": "turbo run type-check",
    "dev": "turbo run dev",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.14",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Aakif-Kohari/CogniPipe.git"
  },
  "author": "Aakif Kohari <kohariaakif@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/Aakif-Kohari/CogniPipe#readme",
  "keywords": [
    "cognipipe",
    "workflow",
    "automation",
    "pipeline",
    "typescript"
  ],
  "bugs": {
    "url": "https://github.com/Aakif-Kohari/CogniPipe/issues"
  }
}
