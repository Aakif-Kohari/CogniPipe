{
  "name": "@cognipipe/node-slack",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Slack integration node for CogniPipe",
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=11.10.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json && node scripts/postbuild-cjs.js",
    "test": "jest --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@cognipipe/core": "workspace:*",
    "@cognipipe/sdk": "workspace:*",
    "@cognipipe/types": "workspace:*",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aakif-Kohari/CogniPipe.git",
    "directory": "nodes/node-slack"
  },
  "homepage": "https://github.com/Aakif-Kohari/CogniPipe/tree/main/nodes/node-slack#readme",
  "bugs": {
    "url": "https://github.com/Aakif-Kohari/CogniPipe/issues"
  },
  "author": "Aakif Kohari <kohariaakif@gmail.com>",
  "keywords": [
    "cognipipe",
    "workflow",
    "automation",
    "pipeline",
    "typescript"
  ],
  "files": [
    "dist"
  ]
}
